{
  "$schema": "https://unpkg.com/wrangler@4.146.0/config-schema.json",
  // GitHub 主页上的信号台：记录访客点的按钮，实时生成日志、按钮和行情 SVG。
  // 部署：在本目录运行 npx wrangler@4.146.0 deploy（首次需要先建 D1 并执行 schema.sql，见 README）
  "name": "elvhack-signal",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "signal.elvhack.com", "custom_domain": true }],
  "rules": [{ "type": "Data", "globs": ["**/*.woff2"], "fallthrough": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "elvhack-signal", "database_id": "3e7578dc-75e2-4433-a34a-e6aab9587c35" }]
}
